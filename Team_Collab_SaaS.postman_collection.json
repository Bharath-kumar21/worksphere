						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"John Doe\",\n    \"email\": \"john@innovatecorp.com\",\n    \"password\": \"password123\",\n    \"organization_name\": \"Innovate Corp\",\n    \"role\": \"admin\"\n}"
						},
						"url": {
